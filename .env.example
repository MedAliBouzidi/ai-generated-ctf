# ==============================================================================
# VulnLab CTF - Environment Template
# ==============================================================================
# WARNING: Do NOT use these dummy values in a live competition!
# Run ./scripts/gen-flags.sh to generate a randomized .env file with fresh 64-hex
# secrets and 32-hex lowercase flags.
# ==============================================================================

# Global Lab Configuration
# Active challenge difficulty: easy | medium | hard
DIFFICULTY=easy

# Scoreboard Master Secret (64 hex lowercase characters)
# Used for HMAC-SHA256 flag verification and admin reset authorization
SCOREBOARD_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Configuration (Internal notes-db PostgreSQL service)
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=notes_super_secure_db_pass
POSTGRES_DB=notes_db
DATABASE_URL=postgres://notes_user:notes_super_secure_db_pass@notes-db:5432/notes_db

# Optional Per-App Difficulty Overrides (defaults to DIFFICULTY if unset)
BLOG_SQLI_DIFFICULTY=easy
NOTES_IDOR_DIFFICULTY=easy
FILE_SHARE_DIFFICULTY=easy
SHOP_AUTH_DIFFICULTY=easy
PING_TOOL_DIFFICULTY=easy

# ==============================================================================
# CHALLENGE FLAGS (Format: VULNLAB{<32-hex-lowercase>})
# ==============================================================================

# ------------------------------------------------------------------------------
# App 1: Blog SQLi (Port 8001)
# ------------------------------------------------------------------------------
FLAG_BLOG_SQLI_LOGIN_EASY=VULNLAB{10000000000000000000000000000001}
FLAG_BLOG_SQLI_LOGIN_MEDIUM=VULNLAB{10000000000000000000000000000002}
FLAG_BLOG_SQLI_LOGIN_HARD=VULNLAB{10000000000000000000000000000003}
